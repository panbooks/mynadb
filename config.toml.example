# Stats Service Configuration Example

[server]
# HTTP REST API host and port
http_host = "0.0.0.0"
http_port = 7000

# Arrow Flight gRPC host and port
flight_host = "0.0.0.0"
flight_port = 7001

[storage]
# Data directory for storing Parquet files
data_dir = "./data"

# System directory name (for metadata and series stats)
system_dir = "_system"

[schema]
# Tag key to extract schema from (default: "service")
# Customize this to use other tags like "hierarchy_1", "hierarchy_2", etc.
tag_key = "service"

# Default schema name when tag is not present
default_name = "default"

# Whether to prefix purely numeric schemas (e.g., "123" -> "service_123")
# This avoids SQL parser issues with numeric identifiers
prefix_numeric = true

# Whether to extract the last part after dot separator
# Examples:
#   false: "MONITOR.service" -> "MONITOR.service" (keeps full value as-is)
#   true:  "MONITOR.service" -> "service" (extracts last part after ".")
# Useful when your service tags are hierarchical
extract_last_part = false

# Custom separator for hierarchical schema names (default: ".")
# Used when extract_last_part = true
separator = "."

[cache]
# Background flush interval in seconds
flush_interval_secs = 30

# Maximum cache size in MB before forcing flush
max_size_mb = 1024

[compaction]
# Minimum number of L0 files to trigger minor compaction (L0 → L1)
min_files = 5

# Minimum number of files at L1+ to trigger major compaction (L1 → L2, L2 → L3, etc.)
major_min_files = 4

# Maximum file size in MB before compaction
max_file_size_mb = 100

# Target file size in MB after compaction
target_file_size_mb = 500

# Maximum compaction level (0-4: L0, L1, L2, L3, L4)
max_level = 4

# Background compaction interval in seconds (0 = disabled)
interval_secs = 60

[series_tracker]
# Background flush interval for series tracking (seconds)
flush_interval_secs = 60

# Series stats directory name
stats_dir = "series_stats"

[logging]
# Log level: trace, debug, info, warn, error
level = "info"

# Log directory path
log_dir = "./logs"

# Log file name prefix
file_prefix = "stats-service"

# Log file rotation: daily, hourly, never
rotation = "daily"

# Maximum number of log files to keep
max_files = 30

# Enable JSON formatted logs (default: false for human-readable format)
json_format = false
