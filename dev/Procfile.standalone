# MynaDB Standalone Development Environment
# Single-node mode with local filesystem storage (default)
#
# For MinIO storage, use: Procfile.standalone-minio
#
# Port assignments:
#   HTTP:   7000
#   Flight: 7001
#   MySQL:  7002
#
# Start with: goreman -f dev/Procfile.standalone start

mynadb: ./target/debug/mynadb -c ./dev/configs/standalone/local.toml standalone
