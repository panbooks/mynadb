# MynaDB Cluster Development Environment
# Full cluster: 3 meta nodes + 1 router + 2 data nodes
#
# Port assignments:
#   meta1:   gRPC 6000, HTTP 6000
#   meta2:   gRPC 6100, HTTP 6100
#   meta3:   gRPC 6200, HTTP 6200
#   router1: HTTP 7000, Flight 7001, MySQL 7002
#   data1:   HTTP 5000, Flight 5001, MySQL 5002, gRPC 5003
#   data2:   HTTP 5100, Flight 5101, MySQL 5102, gRPC 5103
#
# Start with: goreman start

meta1: ./target/debug/mynadb -c ./dev/configs/cluster/meta1.toml meta start
meta2: ./target/debug/mynadb -c ./dev/configs/cluster/meta2.toml meta start
meta3: ./target/debug/mynadb -c ./dev/configs/cluster/meta3.toml meta start
router1: sleep 3 && ./target/debug/mynadb -c ./dev/configs/cluster/router1.toml router start
data1: sleep 3 && ./target/debug/mynadb -c ./dev/configs/cluster/data1.toml data start
data2: sleep 3 && ./target/debug/mynadb -c ./dev/configs/cluster/data2.toml data start
