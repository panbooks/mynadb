[Unit]
Description=TSDB Stats Metric Sender Service
After=network.target

[Service]
Type=simple
User=ansible
Group=ansible
WorkingDirectory=/opt/tsdb-stats/tools
ExecStart=/opt/tsdb-stats/tools/metric-sender
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metric-sender

# Restart policy
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
