[Unit]
Description=MynaDB - The Voice of Your Machines
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/mynadb
ExecStart=/opt/mynadb/mynadb
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mynadb

# Performance and security settings
LimitNOFILE=655360
LimitNPROC=40960

# Restart policy
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
